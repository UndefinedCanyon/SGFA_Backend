# Obligatorias
DB_PASSWORD=tu_contraseña_de_mysql_aqui
JWT_SECRET=una_clave_secreta_larga_para_firmar_los_tokens

# Opcionales (entre paréntesis, el valor por defecto)
# CORS_ORIGINS=http://localhost:5173    (varios orígenes, separados por coma)
# JWT_EXPIRATION_MS=7200000             (2 horas)
# JPA_SHOW_SQL=false                    (true para ver las consultas SQL)
# SWAGGER_ENABLED=true                  (false en producción)
# PORT=8080
# FRONTEND_PATH=../SGFA_Frontend        (solo para docker compose)
# IMAGENES_DIR=./uploads                (carpeta de las imágenes; en Docker es /data/imagenes)
# Correo (por defecto, en Docker, va a Mailpit: la bandeja falsa de desarrollo)
# APP_URL=http://localhost:5173         (la dirección pública del frontend; va dentro de los enlaces de los correos)
# MAIL_FROM=SGFA <no-reply@sgfa.local>
# MAIL_HOST=mailpit
# MAIL_PORT=1025
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_AUTH=false
# MAIL_STARTTLS=false
# SONAR_DB_PASSWORD=             (contraseña de la base de datos de SonarQube)