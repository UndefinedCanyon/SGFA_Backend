# Plantilla del archivo ~/sgfa/.env de la VM. Cópiala a .env y rellénala EN LA VM.
# Este archivo real (.env) nunca se sube al repositorio.

# Dominio público (el de Azure, sin https://), p. ej. sgfa-juan.chilecentral.cloudapp.azure.com
DOMINIO=

# Dueño de las imágenes en GHCR, en minúsculas
GHCR_OWNER=undefinedcanyon

# Secretos (genera el JWT con:  openssl rand -base64 48 )
DB_PASSWORD=
JWT_SECRET=

# Correo real (ejemplo Gmail con contraseña de aplicación)
MAIL_FROM=SGFA <tu_correo@gmail.com>
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu_correo@gmail.com
MAIL_PASSWORD=
MAIL_AUTH=true
MAIL_STARTTLS=true

# Asistente de IA (opcional)
GEMINI_API_KEY=
